# Copy to .env and fill in values as needed. NEVER commit real secrets.

# --- LLM features (optional) ---------------------------------------------
# The deterministic core (detectors, oracles, injection, metrics, CI gate)
# needs NONE of these. Set to true only to enable semantic judging.
FAILSAFE_LLM_ENABLED=false
FAILSAFE_LLM_PROVIDER=openai
FAILSAFE_LLM_MODEL=gpt-4o-mini

# API keys are read from the environment only; never stored in config files.
OPENAI_API_KEY=

# --- Database -------------------------------------------------------------
# Default: SQLite (zero-config). Uncomment for PostgreSQL in production.
# FAILSAFE_DB_URL=postgresql+psycopg2://user:password@localhost:5432/failsafe
FAILSAFE_DB_URL=sqlite:///failsafe.db

# --- Detector configuration ----------------------------------------------
# FAILSAFE_DETECTORS__REPEAT_MIN_COUNT=3
# FAILSAFE_DETECTORS__RETRY_BUDGET=3
# FAILSAFE_DETECTORS__REQUIRE_FAILURE_REPORT=true

# --- Fault injection ------------------------------------------------------
# FAILSAFE_INJECTION__SEED=1337
# FAILSAFE_INJECTION__MAX_INJECTIONS=5
# FAILSAFE_INJECTION__ALLOW_REAL_SYSTEMS=false

# --- Budgets (investigation agent / campaigns) ---------------------------
# FAILSAFE_BUDGETS__MAX_ITERATIONS=12
# FAILSAFE_BUDGETS__MAX_TOOL_CALLS=30
# FAILSAFE_BUDGETS__MAX_SECONDS=120

# --- CI gate -------------------------------------------------------------
# strict | report-only
# FAILSAFE_CI__MODE=strict
# FAILSAFE_CI__FAIL_ON_MIN_SEVERITY=high

# --- Streamlit viewer ----------------------------------------------------
# FAILSAFE_UI_DB_URL=sqlite:///failsafe.db
